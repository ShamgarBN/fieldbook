# Copy to .env and adjust. Load with: node --env-file=.env ...  (or dotenv, already wired in config.ts)

# --- Server ---
PORT=3000
# How often the display page polls /state, in seconds (5-15 recommended)
DISPLAY_POLL_SECONDS=8

# --- Display state machine ---
# A species stays "active" for this many minutes after its last detection (Ben-specified: 10)
ACTIVE_WINDOW_MINUTES=10
# After the last bird drops off, hold the empty nest this many minutes before the
# collage takes over. 0 = skip the nest and go straight to the collage.
NEST_WINDOW_MINUTES=15
# Idle collage shows everything heard in this rolling window, in hours (48 = carry owls into daytime)
COLLAGE_WINDOW_HOURS=48
# Ignore detections below this confidence (0..1); BirdNET-Go default threshold is separate
MIN_CONFIDENCE=0.6

# --- Detection ingestion (MQTT from BirdNET-Go) ---
# The Mosquitto broker runs on the Pi. When the app runs on the SAME Pi (the simple
# all-in-one setup) use mqtt://localhost:1883; from a separate machine use
# mqtt://<pi-host>:1883. Leave blank to disable MQTT (e.g. a dev laptop with no broker).
MQTT_URL=
MQTT_TOPIC=birdnet
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Art generation (Phase 4; not required to run the server) ---
OPENAI_API_KEY=
IMAGE_BACKEND=openai
IMAGE_MODEL=gpt-image-1.5
# Image render options (defaults shown)
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1536
# Cost cap: max NEW species this process will paint on the fly before it stops
# (each is a paid API call). Unset = 50. Set 0 to disable on-the-fly painting.
MAX_GROW_BIRDS=50

# --- Dev routes ---
# /simulate (inject fake detections) is auto-on when MQTT_URL is blank (dev laptop).
# On the real device set this to 1 to re-enable it for testing.
ENABLE_SIMULATE=
